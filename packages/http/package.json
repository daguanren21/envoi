{
  "name": "@envoijs/http",
  "version": "0.2.0",
  "description": "Typed HTTP client: dispatch a request, then unwrap the envelope into T.",
  "keywords": [
    "axios",
    "envelope",
    "fetch",
    "http",
    "ofetch",
    "typescript"
  ],
  "homepage": "https://github.com/daguanren21/envoi#readme",
  "bugs": {
    "url": "https://github.com/daguanren21/envoi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/envoi.git",
    "directory": "packages/http"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir ../.."
  },
  "dependencies": {
    "axios": "catalog:",
    "ufo": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "ofetch": "^1.5.1"
  },
  "peerDependenciesMeta": {
    "ofetch": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
